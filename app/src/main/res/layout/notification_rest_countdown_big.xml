<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded rest countdown: a big live clock over the exercise and what's next; +30 s and Skip follow as actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <Chronometer
        android:id="@+id/rest_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/rest_notification_accent"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rest_title"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/rest_next"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />
</LinearLayout>
