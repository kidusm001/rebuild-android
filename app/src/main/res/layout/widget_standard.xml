            </LinearLayout>
            <LinearLayout
                android:id="@+id/row_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="28dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/row_6_mark"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/row_6_num"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/widget_badge_pending"
                        android:scaleType="center"
                        android:importantForAccessibility="no"
                        android:tint="@color/widget_on_surface" />

                    <ImageView
                        android:id="@+id/row_6_cur"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/widget_badge_current"
                        android:scaleType="center"
                        android:importantForAccessibility="no"
                        android:tint="@color/widget_on_primary_container" />

                    <ImageView
                        android:id="@+id/row_6_done"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:background="@drawable/widget_badge_done"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:src="@drawable/ic_check"
                        android:tint="@color/widget_on_surface_variant"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/row_6_day"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical|start"
                        android:visibility="gone"
                        android:adjustViewBounds="true"
                        android:scaleType="fitStart"
                        android:importantForAccessibility="no"
                        android:tint="@color/widget_on_surface_variant" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/row_6_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_on_surface" />

                <ImageView
                    android:id="@+id/row_6_name_muted"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    android:scaleType="matrix"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_on_surface_variant" />
                <ImageView
                    android:id="@+id/row_6_trail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart"
                    android:importantForAccessibility="no"
                    android:tint="@color/widget_on_surface_variant" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/list_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="34dp"
            android:visibility="gone"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:importantForAccessibility="no"
            android:tint="@color/widget_on_surface_variant" />

        <FrameLayout
            android:id="@+id/list_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:importantForAccessibility="no"
            android:tint="@color/widget_on_surface_variant" />
    </LinearLayout>
</FrameLayout>
