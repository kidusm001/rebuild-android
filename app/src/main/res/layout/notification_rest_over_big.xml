<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded "rest over": the next set large in the accent, like the expanded countdown's clock, then "Rest over"
     and the exercise. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rest_over_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/rest_notification_accent"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rest_over_of"
            android:layout_width="wrap_content"
            android:alpha="0.55"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/rest_notification_accent"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/rest_over_label"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/rest_over_detail"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />
</LinearLayout>
