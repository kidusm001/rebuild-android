<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded "rest over": the amber card with the next set in large numerals and what it belongs to. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rest_notification_card"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/rest_over_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.14"
        android:textColor="@color/rest_notification_card_ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rest_over_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/rest_notification_card_ink"
        android:textSize="48sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rest_over_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/rest_notification_card_ink"
        android:textSize="15sp" />
</LinearLayout>
