<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed "rest over": an amber card, the label small and the next set big beside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rest_notification_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/rest_over_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.14"
        android:textColor="@color/rest_notification_card_ink_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rest_over_headline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/rest_notification_card_ink"
        android:textSize="26sp"
        android:textStyle="bold" />
</LinearLayout>
