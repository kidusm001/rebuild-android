<?xml version="1.0" encoding="utf-8"?>
<!-- Archivo for words, so views outside Compose (notifications, the window theme) use the app's face too.
     Built by scripts/fonts/build_archivo.py. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/archivo_regular" android:fontStyle="normal" android:fontWeight="400" />
    <font android:font="@font/archivo_medium" android:fontStyle="normal" android:fontWeight="500" />
    <font android:font="@font/archivo_semibold" android:fontStyle="normal" android:fontWeight="600" />
    <font android:font="@font/archivo_bold" android:fontStyle="normal" android:fontWeight="700" />
</font-family>
