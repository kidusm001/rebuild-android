<resources>
    <style name="Theme.Rebuild" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#0F0E0D</item>
    </style>
    <!-- The launch splash: the canvas with the launcher icon on its own disc (cream strokes on the canvas alone would
         be invisible). It hands over to Theme.Rebuild once the first screen can draw. -->
    <style name="Theme.Rebuild.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#0F0E0D</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_rebuild_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rebuild</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
