<resources>
    <style name="Theme.Rebuild" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/archivo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F3EFE9</item>
    </style>
    <!-- The launch splash: the canvas with the launcher icon on its own disc (amber strokes on the cream canvas alone would
         wash out). It hands over to Theme.Rebuild once the first screen can draw. -->
    <style name="Theme.Rebuild.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">#F3EFE9</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_rebuild_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Rebuild</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
